":"30 g de cebolla","p":"cebolla"},{"t":"60 g de tomate triturado","p":"tomtri"},{"t":"1 cucharadita de AOVE (5 g)","p":"aove"},{"t":"Aparte: 140 g de boniato asado","p":"batata"}],"pasos":["Separa las hojas del puerro y escáldalas 2 minutos para que se ablanden.","Sofríe la cebolla picada con el aceite, añade el pollo picado y el tomate triturado, y cocina 8 minutos.","Pon el relleno en cada hoja y ciérrala como un saquito.","Hornéalos 10 minutos a 200 °C. El boniato, asado aparte."],"video":"https://www.instagram.com/p/DCWdP4goLUr/","nota":null,"donde":["Sábado · comida"]},"alcachofas":{"nombre":"Alcachofas con crujiente de queso","minutos":15,"frase":"Con salmón a la plancha.","ing":[{"t":"200 g de corazones de alcachofa","p":"alcachofa"},{"t":"8 g de parmesano o grana padano rallado","p":"grana"},{"t":"Sal en escamas","p":null},{"t":"Aparte: 90 g de salmón a la plancha","p":"salmon"}],"pasos":["Escurre bien los corazones de alcachofa y sécalos con papel.","Ábrelos un poco y colócalos en una bandeja con papel de horno.","Espolvorea el queso rallado por encima.","Horno o freidora de aire a 200 °C, 8-10 minutos, hasta que el queso esté dorado y crujiente. Termina con sal en escamas."],"video":"https://www.instagram.com/p/DCw5tPuumHC/","nota":null,"donde":["Sábado · cena"]}},"dias":[{"dia":"Lunes","tema":"Lunes naranja","kcal":1360,"p":148,"hc":115,"g":31,"comidas":[{"toma":"Desayuno","kcal":347,"p":31,"hc":34,"g":9,"nombre":"Porridge de calabaza y canela","ing":["40 g de copos de avena","150 ml de bebida de almendra 0 %","80 g de calabaza","100 g de queso fresco batido 0 %","20 g de proteína whey","5 g de nueces"],"recetas":["porridge"],"productos":["avena","almendra","calabaza","qfb","whey","nuez"]},{"toma":"Comida","kcal":486,"p":49,"hc":45,"g":11,"nombre":"Crema ligera de calabaza y puerro + pollo a la plancha con quinoa","ing":["200 g de calabaza","60 g de puerro","1 cucharadita de AOVE","170 g de pechuga de pollo","50 g de quinoa"],"recetas":["cremacalabaza"],